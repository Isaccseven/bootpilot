{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "BootPilot",
  "version": "0.1.0",
  "identifier": "de.bootpilot.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build",
    "devUrl": "http://127.0.0.1:5173",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [{"label":"main", "title":"BootPilot", "width":1180, "height":820, "minWidth":760, "minHeight":600}],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self' data:; font-src 'self'; connect-src ipc: http://ipc.localhost; object-src 'none'; base-uri 'self'; frame-src 'none'; form-action 'none'",
      "capabilities": ["main"]
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": ["icons/icon.ico"],
    "license": "MIT",
    "licenseFile": "../LICENSE",
    "externalBin": ["binaries/boot-admin", "binaries/boot-cli", "binaries/boot-mcp"],
    "resources": {
      "../LICENSE": "LICENSE",
      "../README.md": "README.md",
      "../THIRD-PARTY-NOTICES.md": "THIRD-PARTY-NOTICES.md",
      "generated/THIRD-PARTY-LICENSES.txt": "THIRD-PARTY-LICENSES.txt",
      "../docs/BENUTZUNG.md": "docs/BENUTZUNG.md",
      "../docs/ARCHITEKTUR.md": "docs/ARCHITEKTUR.md",
      "../docs/PRUEFBERICHT.md": "docs/PRUEFBERICHT.md",
      "../docs/CI.md": "docs/CI.md",
      "../scripts/register-codex.ps1": "scripts/register-codex.ps1",
      "../scripts/verify-package.ps1": "scripts/verify-package.ps1"
    },
    "windows": {
      "webviewInstallMode": {"type": "downloadBootstrapper", "silent": true},
      "nsis": {
        "installMode": "perMachine",
        "languages": ["German", "English"],
        "displayLanguageSelector": true
      }
    }
  }
}
