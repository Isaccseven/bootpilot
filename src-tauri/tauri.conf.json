{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "BootPilot",
  "version": "0.1.0",
  "identifier": "de.bootpilot.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build",
    "devUrl": "http://127.0.0.1:5173",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [{"label":"main", "title":"BootPilot", "width":1180, "height":820, "minWidth":760, "minHeight":600}],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self' data:; font-src 'self'; connect-src ipc: http://ipc.localhost; object-src 'none'; base-uri 'self'; frame-src 'none'; form-action 'none'",
      "capabilities": ["main"]
    }
  },
  "bundle": {"active":false, "icon":["icons/icon.ico"]}
}
